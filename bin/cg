#!/usr/bin/env bash
# qol: Pick a file with a highlighted preview, then read it
# shellcheck source=/dev/null
. "$QOL_LIB"

if [[ ${1-} == --preview ]]; then
  ui_preview_file "$2"
  exit 0
fi
ui_need_tty
file=$(fzf --prompt='file> ' --scheme=path --ansi --query "$*" --preview "${0@Q} --preview {}" \
  < <(fd --type f --hidden --exclude .git --color=always))
bat --paging=always -- "$file"
