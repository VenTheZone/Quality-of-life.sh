#!/usr/bin/env bash
# qol: Search text live with ripgrep; Enter opens the match in your editor
# shellcheck source=/dev/null
. "$QOL_LIB"

ui_need_tty
# fzf's ripgrep recipe: fzf does no filtering (--disabled), rg reruns on every keystroke
rg='rg --line-number --column --no-heading --color=always --smart-case --'
fzf --ansi --disabled --prompt='text >> ' --query "$*" \
  --bind "start:reload:$rg {q} || true" \
  --bind "change:reload:sleep 0.1; $rg {q} || true" \
  --delimiter : \
  --preview 'bat --color=always --style=numbers --highlight-line {2} -- {1}' \
  --preview-window 'right,60%,border-left,+{2}+3/3,~3' \
  --bind "enter:become:${EDITOR:-nvim} +{2} -- {1}"
